<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 主内容：reasonix AI Agent 交互页面（GUI 会话视图 / CLI 终端） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 顶边栏：仅保留「菜单」入口（其余功能在侧滑栏/高级设置） -->
            <LinearLayout
                android:id="@+id/quick_bar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/qb_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="&#9776; 菜单"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 快捷栏分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E1E" />

            <!-- 原生会话视图（对话模式）：reasonix 会话 jsonl 字段映射为消息列表气泡渲染，
                 与 xterm.js 终端（webview）可切换。默认隐藏。 -->
            <LinearLayout
                android:id="@+id/native_chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 会话信息条：当前会话/模型/状态字段 + 会话操作快捷按钮（纯黑底） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="8dp"
                    android:paddingRight="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/native_session_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="会话：—"
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/native_msg_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingRight="8dp"
                        android:text="0 条"
                        android:textColor="#58A6FF"
                        android:textSize="11sp" />

                    <!-- 会话操作：仅原生视图显示；新会话/回终端（黑底白字） -->
                    <TextView
                        android:id="@+id/native_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="新会话"
                        android:textColor="#7FDB8A"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/native_gototerm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:background="#1A1A1A"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="回终端"
                        android:textColor="#FFD54F"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 终端实时流（剥离 TUI 组件的纯文本，供 AI 工具输出/AI 思考滚动显示） -->
                <TextView
                    android:id="@+id/native_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0A0A0A"
                    android:fontFamily="monospace"
                    android:maxLines="200"
                    android:padding="6dp"
                    android:scrollbars="vertical"
                    android:textColor="#C9D1D9"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- 消息列表：字段映射气泡（user 右对齐 / assistant 左对齐 / tool 灰色） -->
                <ScrollView
                    android:id="@+id/native_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#000000"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/native_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#000000"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <EditText
                        android:id="@+id/native_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#1A1A1A"
                        android:hint="输入指令（Enter 发送）"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:maxLines="3"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#707070" />

                    <Button
                        android:id="@+id/native_send"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#262626"
                        android:text="发送"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 左侧侧滑配置菜单 -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#000000"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:text="RSXM"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ── 视图 ── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="视图"
                        android:textColor="#6E7681"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/menu_view"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="对话 / 终端"
                        android:textColor="#FFD54F"
                        android:textSize="15sp"
                        android:drawablePadding="12dp" />

                    <!-- ── 会话 ── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="会话"
                        android:textColor="#6E7681"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/menu_sessions"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="历史会话"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_project"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="项目目录"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <!-- ── 服务 ── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="服务"
                        android:textColor="#6E7681"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/menu_apikey"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="API Key"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_ds2api"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="DS2API 网关"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_github"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="GitHub 账号"
                        android:textColor="#58A6FF"
                        android:textSize="15sp" />

                    <!-- ── 系统 ── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="4dp"
                        android:text="系统"
                        android:textColor="#6E7681"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/menu_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="更新 Reasonix"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_adb"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="ADB 调试"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_advanced"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="高级设置"
                        android:textColor="#FFD54F"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="RSXM V2.0"
                        android:textColor="#3A3F47"
                        android:textSize="11sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 全屏功能面板（页面式切换，取代系统弹窗，避免遮挡控件）：
         ADB / API Key / 更新 / Root 等统一在此展示，默认隐藏 -->
    <LinearLayout
        android:id="@+id/panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 面板标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 关闭面板：返回箭头（←）+ 系统返回键，无需多余关闭按钮 -->
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E1E" />

        <!-- 面板内容区（各功能内容动态填充）。
             改为普通 ScrollView：高级设置等长面板需要整体可滑动 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>

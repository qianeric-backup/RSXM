<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 主内容：reasonix AI Agent 交互页面（CLI 输入输出） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="&#9776;"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RSXM"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:padding="6dp"
                    android:text="&#9679;"
                    android:textColor="#4CAF50"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 标题栏分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E1E" />

            <!-- 主屏快捷入口行：常用功能一键直达，不再需要打开侧滑栏 -->
            <HorizontalScrollView
                android:id="@+id/quick_bar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#0A0A0A"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingRight="8dp">

                    <TextView
                        android:id="@+id/qb_github"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="GitHub"
                        android:textColor="#58A6FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/qb_view"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="视图：终端"
                        android:textColor="#FFD54F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/qb_adb"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="ADB"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_apikey"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="API Key"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_ds2api"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="DS2API"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_update"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="更新"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_project"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="项目"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="会话"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_skill"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="SKILL"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_mcp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="MCP"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_dev"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="开发环境"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_keys"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="快捷键"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/qb_root"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="ROOT"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 快捷栏分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E1E1E" />

            <!-- 原生会话视图（对话模式）：原生控件渲染 reasonix 输出 + 原生输入框，
                 与 xterm.js 终端（webview）可切换。默认隐藏。 -->
            <LinearLayout
                android:id="@+id/native_chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/native_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#000000"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/native_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:textColor="#E6EDF3"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:typeface="monospace" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0A0A0A"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <EditText
                        android:id="@+id/native_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:drawable/edit_text"
                        android:hint="输入指令（Enter 发送）"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:maxLines="3"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#707070" />

                    <Button
                        android:id="@+id/native_send"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="发送"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 左侧侧滑配置菜单 -->
        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#000000"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#000000"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:text="配置"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/menu_adb"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="ADB 调试"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_apikey"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="API Key"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_github"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="GitHub（登录/自动打包）"
                        android:textColor="#58A6FF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_ds2api"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="DS2API 网关"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_update"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="Reasonix 更新"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_dev"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="开发环境"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_project"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="项目"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_sessions"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="会话"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_skill"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="SKILL"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_mcp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="MCP 服务器"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_bgmode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="后台运行：关"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_yolo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="YOLO 免审批：开"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <!-- 上下滑动调速 -->
                    <LinearLayout
                        android:id="@+id/menu_speed"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:paddingRight="12dp">

                        <TextView
                            android:id="@+id/tv_speed_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="滑动速度"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_speed_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="当前：5 档"
                            android:textColor="#8A8A8A"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/sb_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="9"
                            android:progress="4"
                            android:paddingTop="2dp"
                            android:paddingBottom="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/menu_keys"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="快捷键（悬浮工具栏）"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/menu_root"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="#141414"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="16dp"
                        android:text="ROOT"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 全屏功能面板（页面式切换，取代系统弹窗，避免遮挡控件）：
         ADB / API Key / 更新 / Root 等统一在此展示，默认隐藏 -->
    <LinearLayout
        android:id="@+id/panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 面板标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="&#8592;"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 关闭面板：返回箭头（←）+ 系统返回键，无需多余关闭按钮 -->
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E1E" />

        <!-- 面板内容区（各功能内容动态填充） -->
        <!-- 面板内容区（各功能内容动态填充）。
             LockedScrollView：功能页整体不可滑动，仅列表/输入框内部二级滚动 -->
        <com.rsxm.app.LockedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.rsxm.app.LockedScrollView>
    </LinearLayout>
</FrameLayout>
